# Copy this file to `.env` for local development, and add the same values
# as environment variables in your hosting provider. Never commit `.env`.

# ── Supabase (Dashboard → Project Settings → API) ─────────────────────────
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"
# Secret, server only. Bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── Stripe (Dashboard → Developers → API keys) ───────────────────────────
# Use pk_test_/sk_test_ keys while testing; the site shows a "test mode" banner.
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
# Signing secret of the webhook endpoint https://<domain>/api/public/payments/webhook
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Email via Resend (https://resend.com → API Keys) ─────────────────────
RESEND_API_KEY="re_..."
# Must use a domain verified in Resend.
EMAIL_FROM="Wellness Med Club <noreply@wellnessmedclub.com>"
# Supabase → Authentication → Hooks → Send Email hook (HTTPS) → secret
SEND_EMAIL_HOOK_SECRET="v1,whsec_..."

# ── Site ─────────────────────────────────────────────────────────────────
# Public URL, no trailing slash. Used in email links.
PUBLIC_SITE_URL="https://wellnessmedclub.com"
